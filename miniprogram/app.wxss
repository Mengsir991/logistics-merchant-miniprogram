/* ===== 设计变量 ===== */
page {
  --c-primary: #2563eb;
  --c-primary-dark: #1d4ed8;
  --c-primary-soft: #eef4ff;
  --c-danger: #e4393c;
  --c-danger-soft: #fdeeee;
  --c-warn: #ff8f1f;
  --c-warn-soft: #fff4e6;
  --c-success: #07c160;
  --c-success-soft: #e8f9f0;

  --c-text: #1a2233;
  --c-text-2: #6b7688;
  --c-text-3: #9aa4b2;
  --c-line: #eef1f6;
  --c-bg: #f4f6fa;
  --c-card: #ffffff;

  --fs-xs: 22rpx;
  --fs-sm: 24rpx;
  --fs-base: 28rpx;
  --fs-lg: 32rpx;
  --fs-xl: 40rpx;

  --radius: 16rpx;
  --radius-lg: 24rpx;

  background: var(--c-bg);
  color: var(--c-text);
  font-size: var(--fs-base);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  box-sizing: border-box;
}

view,
text,
input,
textarea,
button,
image,
scroll-view {
  box-sizing: border-box;
}

/* ===== 布局 ===== */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-with-bar {
  padding-bottom: 160rpx; /* 底部固定操作条留位 */
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* ===== 卡片 / 列表 ===== */
.card {
  background: var(--c-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin: 20rpx 24rpx;
}

.card-flat {
  background: var(--c-card);
  padding: 28rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 20rpx 28rpx;
  background: var(--c-card);
  border-bottom: 1rpx solid var(--c-line);
}

.cell:last-child {
  border-bottom: none;
}

.divider {
  height: 1rpx;
  background: var(--c-line);
  margin: 20rpx 0;
}

/* ===== 文字 ===== */
.title {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--c-text);
}

.subtitle {
  font-size: var(--fs-sm);
  color: var(--c-text-2);
}

.muted {
  color: var(--c-text-3);
  font-size: var(--fs-sm);
}

.num {
  font-size: var(--fs-xl);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: var(--fs-base);
  font-weight: 500;
  line-height: 1;
  padding: 0 40rpx;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--c-primary);
  color: #fff;
}

.btn-primary.btn-disabled {
  background: #b9c8e8;
  color: #fff;
}

.btn-ghost {
  background: #fff;
  color: var(--c-primary);
  border: 1rpx solid var(--c-primary);
}

.btn-plain {
  background: #f2f4f8;
  color: var(--c-text-2);
}

.btn-sm {
  height: 60rpx;
  font-size: var(--fs-sm);
  border-radius: 30rpx;
  padding: 0 24rpx;
}

/* ===== 标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: var(--fs-xs);
  line-height: 1;
}

.tag-primary {
  background: var(--c-primary-soft);
  color: var(--c-primary);
}

.tag-warn {
  background: var(--c-warn-soft);
  color: var(--c-warn);
}

.tag-danger {
  background: var(--c-danger-soft);
  color: var(--c-danger);
}

.tag-success {
  background: var(--c-success-soft);
  color: var(--c-success);
}

.tag-plain {
  background: #f2f4f8;
  color: var(--c-text-2);
}

/* ===== 底部固定操作条 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(26, 34, 51, 0.06);
}

/* ===== 骨架屏 ===== */
.skeleton {
  background: #fff;
  border-radius: var(--radius-lg);
  margin: 20rpx 24rpx;
  padding: 28rpx;
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f2f6 25%, #e6eaf1 37%, #f0f2f6 63%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
  margin-bottom: 18rpx;
}

@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
