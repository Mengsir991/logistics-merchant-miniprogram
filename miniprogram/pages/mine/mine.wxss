/* ===== 商家卡片 ===== */
.profile {
  display: flex;
  align-items: center;
  gap: 26rpx;
  background: linear-gradient(150deg, #2f6bff 0%, #1d4ed8 100%);
  padding: 48rpx 32rpx 64rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.profile-role {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* ===== 分组 ===== */
.group-title {
  padding: 36rpx 40rpx 12rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.group {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 24rpx;
  overflow: hidden;
}

.row-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #f2f5f9;
}

.row-item:last-child {
  border-bottom: none;
}

.ri-label {
  flex: 1;
  font-size: 28rpx;
  color: #1a2233;
}

.ri-value {
  font-size: 25rpx;
  color: #8a94a6;
  margin-right: 8rpx;
}

.ri-arrow {
  font-size: 32rpx;
  color: #c2c9d4;
  margin-left: 6rpx;
}

/* ===== 页脚 ===== */
.footer {
  padding: 60rpx 0 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b6becd;
}
