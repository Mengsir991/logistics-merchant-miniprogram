{
  "pages": [
    "pages/index/index",
    "pages/order-list/order-list",
    "pages/mine/mine"
  ],
  "subPackages": [
    {
      "root": "pagesShip",
      "name": "ship",
      "pages": [
        "batch-import/batch-import",
        "order-detail/order-detail",
        "print/print"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["ship"]
    },
    "pages/order-list/order-list": {
      "network": "all",
      "packages": ["ship"]
    }
