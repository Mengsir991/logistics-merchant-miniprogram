.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
}

.empty-icon {
  font-size: 88rpx;
  line-height: 1;
  opacity: 0.55;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #6b7688;
  font-weight: 500;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9aa4b2;
  text-align: center;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 36rpx;
  height: 72rpx;
  padding: 0 44rpx;
  border-radius: 36rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
