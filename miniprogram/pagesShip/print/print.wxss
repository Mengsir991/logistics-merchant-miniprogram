.page {
  padding-bottom: 180rpx;
  background: #eef1f6;
}

/* ===== 加载 ===== */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 30rpx;
}

.loading-ring {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid #dbe3f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: ring 0.9s linear infinite;
}

@keyframes ring {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #8a94a6;
}

/* ===== 顶栏 ===== */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.progress {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2233;
}

.copy {
  font-size: 24rpx;
  color: #2563eb;
}

/* ===== 警告 ===== */
.warn {
  margin: 0 24rpx 16rpx;
  padding: 20rpx 24rpx;
  background: #fdeeee;
  border-radius: 14rpx;
  font-size: 23rpx;
  color: #c0282b;
  line-height: 1.5;
}

/* ===== 面单画布 =====
   750rpx 设计宽度下：690 / 1242 = 800 / 1440，保证比例与画布像素一致。
   canvas 内部按 800×1440 绘制，视觉上等比缩放，导出的图片仍是 800×1440。 */
.label-wrap {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 24rpx;
}

.label-canvas {
  width: 690rpx;
  height: 1242rpx;
  background: #fff;
  border-radius: 8rpx;
  box-shadow: 0 6rpx 32rpx rgba(26, 34, 51, 0.14);
}

.label-img {
  width: 690rpx;
  background: #fff;
  border-radius: 8rpx;
  box-shadow: 0 6rpx 32rpx rgba(26, 34, 51, 0.14);
}

/* ===== 提示 ===== */
.hint {
  margin: 0 24rpx 24rpx;
  padding: 24rpx 26rpx;
  background: #fff;
  border-radius: 16rpx;
}

.hint-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #ff8f1f;
  margin-bottom: 10rpx;
}

.hint-text {
  font-size: 23rpx;
  color: #6b7688;
  line-height: 1.6;
}
