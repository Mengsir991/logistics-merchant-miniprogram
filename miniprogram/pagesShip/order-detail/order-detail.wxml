<view class="page page-with-bar">

  <block wx:if="{{loading}}">
    <view class="skeleton">
      <view class="sk-line" style="width:45%"></view>
      <view class="sk-line" style="width:80%"></view>
      <view class="sk-line" style="width:60%"></view>
    </view>
  </block>

  <block wx:elif="{{error}}">
    <view class="card" style="margin-top:80rpx">
      <empty-state icon="⚠️" text="加载失败" desc="{{error}}" button-text="重试" bind:action="onRetry" />
    </view>
  </block>

  <block wx:else>
    <!-- 头部状态 -->
    <view class="hero">
      <view class="between">
        <text class="hero-status">{{order.statusText}}</text>
        <text class="hero-express">{{order.expressName}}</text>
      </view>
      <view class="hero-waybill" bindtap="onCopy" data-value="{{order.waybillNo}}">
        {{order.waybillNo || '未取号'}}
        <text class="hero-copy" wx:if="{{order.waybillNo}}">复制</text>
      </view>
      <view class="hero-sub">订单号 {{order.shopOrderNo}}</view>
    </view>

    <!-- 收件人 -->
    <view class="card">
      <view class="block-head">
        <text class="block-tag">收</text>
        <text class="block-name">{{order.receiver.name}}</text>
        <text class="block-phone" bindtap="onCopy" data-value="{{order.receiver.phone}}">{{order.receiver.phone}}</text>
      </view>
      <view class="block-addr">{{order.receiverAddr}}</view>
    </view>

    <!-- 寄件人 -->
    <view class="card">
      <view class="block-head">
        <text class="block-tag block-tag-gray">寄</text>
        <text class="block-name">{{order.sender.name || '未设置'}}</text>
        <text class="block-phone" wx:if="{{order.sender.phone}}">{{order.sender.phone}}</text>
      </view>
      <view class="block-addr">{{order.senderAddr || '请先在「我的 - 发货信息」里配置默认寄件地址'}}</view>
    </view>

    <!-- 商品信息 -->
    <view class="card">
      <view class="kv">
        <text class="kv-k">重量</text>
        <text class="kv-v">{{order.goods.weight}} kg</text>
      </view>
      <view class="kv">
        <text class="kv-k">件数</text>
        <text class="kv-v">{{order.goods.count}} 件</text>
      </view>
      <view class="kv">
        <text class="kv-k">创建时间</text>
        <text class="kv-v">{{order.createdText}}</text>
      </view>
      <view class="kv">
        <text class="kv-k">打印状态</text>
        <text class="kv-v">{{order.printStatus === 'printed' ? '已打印' : '未打印'}}</text>
      </view>
    </view>

    <!-- 物流轨迹 -->
    <view class="section-head">
      <text class="section-title">物流轨迹</text>
      <text class="section-refresh" wx:if="{{order.waybillNo}}" bindtap="loadTrace">
        {{tracing ? '查询中…' : '刷新'}}
      </text>
    </view>

    <view class="card">
      <block wx:if="{{trace.length}}">
        <view class="tl-item {{index === 0 ? 'tl-active' : ''}}" wx:for="{{trace}}" wx:key="index">
          <view class="tl-axis">
            <view class="tl-dot"></view>
            <view class="tl-line" wx:if="{{index !== trace.length - 1}}"></view>
          </view>
          <view class="tl-body">
            <view class="tl-desc">{{item.desc}}</view>
            <view class="tl-time">{{item.time}}</view>
          </view>
        </view>
      </block>
      <empty-state
        wx:else
        icon="🚚"
        text="{{order.waybillNo ? '暂无轨迹' : '未取号'}}"
        desc="{{order.waybillNo ? '快递员揽收后会更新轨迹' : '取号后即可查询物流轨迹'}}"
      />
    </view>

    <!-- 底部操作 -->
    <view class="bottom-bar">
      <view class="btn btn-plain flex-1" wx:if="{{canCancel}}" bindtap="onCancel">取消运单</view>
      <view class="btn btn-primary flex-1" bindtap="onPrint">打印面单</view>
    </view>
  </block>

</view>
