.hero {
  background: linear-gradient(150deg, #2f6bff 0%, #1d4ed8 100%);
  padding: 40rpx 32rpx 56rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.hero-status {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
}

.hero-express {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.hero-waybill {
  margin-top: 26rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  font-family: Menlo, Consolas, monospace;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-copy {
  font-size: 20rpx;
  font-family: -apple-system, sans-serif;
  letter-spacing: 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  font-weight: 400;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

/* 卡片上压 */
.hero + .card {
  margin-top: 20rpx;
}

/* ===== 收/寄件 ===== */
.block-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.block-tag {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  background: #1a2233;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.block-tag-gray {
  background: #8a94a6;
}

.block-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2233;
}

.block-phone {
  font-size: 26rpx;
  color: #2563eb;
  font-variant-numeric: tabular-nums;
}

.block-addr {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7688;
  line-height: 1.6;
}

/* ===== KV ===== */
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f5f9;
}

.kv:last-child {
  border-bottom: none;
}

.kv-k {
  font-size: 26rpx;
  color: #8a94a6;
}

.kv-v {
  font-size: 26rpx;
  color: #1a2233;
  font-variant-numeric: tabular-nums;
}

/* ===== 区块标题 ===== */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2233;
}

.section-refresh {
  font-size: 24rpx;
  color: #2563eb;
}

/* ===== 时间轴 ===== */
.tl-item {
  display: flex;
  gap: 22rpx;
}

.tl-axis {
  width: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 10rpx;
}

.tl-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d2d9e5;
  flex-shrink: 0;
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background: #eef1f6;
  margin: 8rpx 0;
}

.tl-body {
  flex: 1;
  padding-bottom: 34rpx;
}

.tl-desc {
  font-size: 26rpx;
  color: #6b7688;
  line-height: 1.55;
}

.tl-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b6becd;
}

.tl-active .tl-dot {
  background: #2563eb;
  box-shadow: 0 0 0 6rpx #eef4ff;
}

.tl-active .tl-desc {
  color: #1a2233;
  font-weight: 500;
}
