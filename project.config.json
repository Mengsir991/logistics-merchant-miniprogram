{
  "description": "物流商家端 - 批量发货打单小程序（原生 + 云开发）",
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "cloudfunctions/",
  "compileType": "miniprogram",
  "appid": "",
  "projectname": "logistics-merchant",
  "libVersion": "3.0.0",
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "node_modules" },
      { "type": "file", "value": ".eslintrc.js" }
    ]
  },
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "coverView": true,
    "nodeModules": false,
    "autoAudits": false,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "uploadWithSourceMap": true,
    "compileHotReLoad": true,
    "packNpmManually": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {
    "miniprogram": {
      "list": [
        {
          "name": "工作台",
          "pathName": "pages/index/index",
          "query": "",
          "scene": null
        },
        {
          "name": "批量导入",
          "pathName": "pagesShip/batch-import/batch-import",
          "query": "",
          "scene": null
        }
      ]
    }
  }
}
